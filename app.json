{
  "expo": {
    "name": "Qual carro?",
    "slug": "qual-carro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "qualcarro",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#241f1b",
      "enableFullScreenImage_legacy": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.qualcarro",
      "appleTeamId": "4PYU2TX7XN",
      "buildNumber": "2",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "privacyManifests": {
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeProductInteraction",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherUserContent",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ],
        "NSPrivacyTracking": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#241f1b"
      },
      "package": "app.qualcarro"
    },
    "extra": {
      "reportsUrl": "https://qual-carro-reports.sunny-mangosteen.workers.dev",
      "privacyPolicyUrl": "https://etheuer.github.io/qual-carro/legal/privacidade.html",
      "supportUrl": "https://etheuer.github.io/qual-carro/legal/suporte.html"
    },
    "plugins": ["expo-dev-client"]
  }
}
